{
  "name": "opentrust-verify",
  "private": true,
  "version": "0.1.0",
  "description": "OpenTrust Verify (OTV) — Trust the balance, not just the blockchain event.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './services/*' --filter './apps/*' run build",
    "dev": "pnpm --parallel --filter @otv/api --filter @otv/dashboard --filter @otv/verifier --filter @otv/marketing --filter @otv/demo-wallet run dev",
    "dev:api": "pnpm --filter @otv/api run dev",
    "dev:dashboard": "pnpm --filter @otv/dashboard run dev",
    "dev:verifier": "pnpm --filter @otv/verifier run dev",
    "dev:marketing": "pnpm --filter @otv/marketing run dev",
    "dev:demo": "pnpm --filter @otv/demo-wallet run dev",
    "test": "pnpm -r --filter './packages/*' --filter './services/*' run test",
    "lint": "pnpm -r run lint --if-present",
    "typecheck": "pnpm -r run typecheck --if-present",
    "demo": "pnpm --filter @otv/api run demo",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "dev:web": "pnpm --filter @otv/web run dev",
    "build:web": "pnpm --filter @otv/design-tokens --filter @otv/config --filter @otv/verdict-schema --filter @otv/crypto-signatures --filter @otv/chain-adapters --filter @otv/verification-engine --filter @otv/api-client --filter @otv/sdk-core --filter @otv/ui --filter @otv/web run build",
    "preview:web": "pnpm --filter @otv/web run preview"
  },
  "engines": {
    "node": ">=20"
  }
}
