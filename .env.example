PORT=4080
HOST=0.0.0.0
NODE_ENV=development
ETH_RPC_URL=
# Optional second RPC for balance reconciliation. Leave empty to use one source.
OTV_BALANCE_RPC_URL=
OTV_KID=otv-dev-1
OTV_KEYS_DIR=./keys
OTV_KMS_MASTER_KEY=
OTV_PUBLIC_URL=https://otv.poptrust.me
OTV_EMBED_WORKER=1
DATABASE_URL=postgres://otv:otv@localhost:5433/otv
REDIS_URL=redis://localhost:6380
SESSION_SECRET=otv-dev-session-secret-change-me-32
DEMO_PASSWORD=otv-demo-change-me
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
VITE_OTV_API_URL=http://localhost:4080
# WalletConnect stays disabled until a project id is set. Do not invent one.
# Also mapped to Open Trust Admin as NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_OTV_API_KEY=otv_test_demo_key_change_me

# Open Trust Admin (/trigger on VPS). Optional — leave signer empty unless set.
# Prefer VPS mainnet RPC (BASE_RPC_URL / ETH_RPC_URL / EVM_RPC_URL). Do not
# invent Sepolia defaults or private keys. deploy-vps-trigger.sh falls back to
# the catalog public Base RPC (base.publicnode.com) when none is set.
# BASE_RPC_URL=https://base.publicnode.com
# ETH_RPC_URL=
# EVM_RPC_URL=
# TRIGGER_ADMIN_SIGNER_PRIVATE_KEY=
# TRIGGER_ADMIN_ALLOWLIST=   # required for ALLOWLIST=YES — set your MetaMask address
# TRIGGER_CHAIN_ID=8453
# TRIGGER_CHAIN_NAME=Base
# TRIGGER_ALLOW_MAINNET=true
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # optional override of VITE_WALLETCONNECT_PROJECT_ID
