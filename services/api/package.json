{
  "name": "@otv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "demo": "tsx src/demo.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1121.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@otv/chain-adapters": "workspace:*",
    "@otv/config": "workspace:*",
    "@otv/crypto-signatures": "workspace:*",
    "@otv/verdict-schema": "workspace:*",
    "@otv/verification-engine": "workspace:*",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.1",
    "pg": "^8.14.1",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
