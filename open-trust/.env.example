# ── Network ──────────────────────────────────────────────────────────────
# Any EVM-compatible RPC works — testnet or mainnet. Defaults below are
# Base mainnet since that's what you've already got an RPC for.
# On the OTV VPS, leave RPC_URL empty and set BASE_RPC_URL / ETH_RPC_URL —
# docker-entrypoint.sh maps those onto RPC_URL automatically.
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
CHAIN_NAME=Base
BLOCK_EXPLORER_BASE=https://basescan.org
EXPLORER_API_BASE=https://api.basescan.org

# Required in addition to CHAIN_ID when the resolved chain is mainnet.
# This is a deliberate second switch so a stale .env never silently starts
# broadcasting real transactions — set it only once ADMIN_ALLOWLIST and
# ADMIN_SIGNER_PRIVATE_KEY are confirmed correct.
ALLOW_MAINNET=true

# ── Signer ───────────────────────────────────────────────────────────────
# Backend-only key. Never exposed to the frontend, never committed.
# On VPS compose this is wired from TRIGGER_ADMIN_SIGNER_PRIVATE_KEY.
# Leave empty unless you intentionally provide a funded allowlisted key.
ADMIN_SIGNER_PRIVATE_KEY=

# ── Admin allowlist ──────────────────────────────────────────────────────
# Comma-separated addresses. liveEngine.ts refuses to send to anything
# outside this list — these must be wallets you yourself control, never a
# third party's address, on mainnet most of all.
ADMIN_ALLOWLIST=

# ── Block explorer / verification APIs ──────────────────────────────────
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# ── AI verification agent ────────────────────────────────────────────────
# Either point at a deployed Vertex AI Agent Builder endpoint, or fall back
# to direct Gemini API calls with the system prompt in src/agent/system-prompt.md
GOOGLE_GENAI_API_KEY=
VERTEX_AGENT_ENDPOINT=

# ── Admin auth ───────────────────────────────────────────────────────────
# Production auth is DB-backed (admin_users). Seed via DEFAULT_ADMIN_* /
# DEMO_PASSWORD — ADMIN_PASSWORD_HASH is legacy/local only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Long random string — e.g. `openssl rand -hex 32`. Signs session cookies;
# rotating it logs every admin session out. On VPS, reuse OTV SESSION_SECRET.
SESSION_SECRET=replace_me

# ── Deployment ───────────────────────────────────────────────────────────
# Hosted under https://otv.poptrust.me/trigger (Next basePath=/trigger).
NEXT_PUBLIC_BASE_PATH=/trigger
NEXT_PUBLIC_SITE_URL=https://otv.poptrust.me

# ── Database ─────────────────────────────────────────────────────────────
# Local: dedicated DB. VPS: shared OTV Postgres (otv DB) — admin_users is
# created by scripts/seed-admin.mjs on container start.
DATABASE_URL=postgres://open_trust:open_trust@127.0.0.1:5432/open_trust
DEFAULT_ADMIN_USERNAME=admin
# On VPS this is set from DEMO_PASSWORD (default otv-demo-change-me).
DEFAULT_ADMIN_PASSWORD=otv-demo-change-me
DEMO_PASSWORD=otv-demo-change-me
